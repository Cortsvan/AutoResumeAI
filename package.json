{
  "name": "autoresumeai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AutoResumeAI - conversational resume studio that edits real DOCX files.",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,gray \"vite\" \"npm run dev --workspace server\"",
    "dev:web": "vite",
    "dev:server": "npm run dev --workspace server",
    "build": "vite build",
    "start": "npm run start --workspace server",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@supabase/supabase-js": "^2.117.3",
    "docx-preview": "^0.4.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.4"
  }
}
